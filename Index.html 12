<!DOCTYPE html>
<html>
<head>
    <title>Online Shopping</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>🛒 My Online Shop</h1>
        <p>Shop your favourite products</p>
    </header>

    <h2>Our Products</h2>

    <div class="products">

        <div class="product">
            <h3>👕 T-Shirt</h3>
            <p>Comfortable cotton T-Shirt</p>
            <h3>₹499</h3>
            <button>Add to Cart</button>
        </div>

        <div class="product">
            <h3>👟 Shoes</h3>
            <p>Stylish casual shoes</p>
            <h3>₹999</h3>
            <button>Add to Cart</button>
        </div>

        <div class="product">
            <h3>🎧 Headphones</h3>
            <p>Wireless headphones</p>
            <h3>₹799</h3>
            <button>Add to Cart</button>
        </div>

    </div>

</body>
</html>
